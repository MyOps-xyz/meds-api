# Configuration de meds-api — copier en `.env` :
#
#   cp .env.example .env
#
# Seule MEDS_API_KEYS est obligatoire. Compose refuse de démarrer sans elle :
# le service ne peut pas être exposé sans authentification par inadvertance.

# ─── Obligatoire ──────────────────────────────────────────────────────────

# Clés API, séparées par des virgules. Chacune doit faire au moins
# 32 caractères et être distincte des autres.
#
# Générer une clé avec 32 octets d'entropie :
#   openssl rand -base64 32 | tr -d '=+/' | sed 's/^/mk_live_/'
MEDS_API_KEYS=

# ─── Administration ───────────────────────────────────────────────────────

# Clé de `POST /admin/sync`, obligatoirement **différente** de toute clé API.
# Laissée vide, l'endpoint répond 404 : il n'existe simplement pas.
#
#   openssl rand -base64 32 | tr -d '=+/' | sed 's/^/mk_admin_/'
MEDS_ADMIN_KEY=

# ─── Synchronisation ──────────────────────────────────────────────────────

# Expression cron à cinq champs. Absente, le défaut `0 4 * * *` s'applique ;
# **présente mais vide, l'ordonnanceur est désactivé** — c'est un état valide,
# celui des instances secondaires d'un déploiement à volume partagé où une
# seule instance synchronise.
MEDS_SYNC_CRON=0 4 * * *

# Décalage aléatoire appliqué à chaque déclenchement. C'est une courtoisie
# envers l'ANSM : sans lui, toutes les instances déployées taperaient à la
# même seconde.
MEDS_SYNC_JITTER=30m

# Synchroniser au démarrage si aucun snapshot n'est présent.
MEDS_SYNC_ON_START=true

# Nombre de snapshots conservés. En garder plusieurs permet un retour arrière
# immédiat en cas de donnée amont défectueuse, pour ~15 Mio chacun.
MEDS_SNAPSHOT_KEEP=3

# Taux de lignes **malformées** au-delà duquel l'ingestion échoue. Les lignes
# hors périmètre — référant une spécialité retirée du marché — ne sont pas
# comptées ici : elles ont leur propre garde-fou
# (docs/adr/0007-hors-perimetre-distinct-du-rejet.md).
MEDS_MAX_REJECT_RATIO=0.01

# ─── Service HTTP ─────────────────────────────────────────────────────────

MEDS_ADDR=:8080
MEDS_DATA_DIR=/data

# Limitation de débit, par clé API et par adresse.
MEDS_RATE_LIMIT=100
MEDS_RATE_BURST=200

# Origines autorisées en CORS, séparées par des virgules. **Vide désactive
# CORS**, ce qui est le bon défaut pour une API à clé : une clé API n'a rien à
# faire dans du code de page web. Le joker `*` est refusé.
MEDS_CORS_ORIGINS=

# debug, info, warn, error.
MEDS_LOG_LEVEL=info

# ─── Frontal (profils caddy et traefik) ───────────────────────────────────

# Nom de domaine servi.
#   - nom public → certificat Let's Encrypt automatique ; l'enregistrement DNS
#     doit pointer vers ce serveur AVANT le démarrage ;
#   - `localhost` → Caddy génère son autorité de certification interne et
#     signe lui-même, sans openssl ni CSR.
DOMAIN=localhost

# Adresse de contact ACME. Facultative : inutile avec `DOMAIN=localhost`,
# recommandée en production pour recevoir les alertes d'expiration.
ACME_EMAIL=

# ─── Métadonnées de build ─────────────────────────────────────────────────

VERSION=dev
COMMIT=unknown
BUILD_DATE=unknown
