# Frontal mutualisé du serveur — détient 80/443 pour TOUS les services hébergés.
#
# Ce fichier ne contient que le global et les fragments réutilisables.
# Un service = un fichier dans conf.d/. Voir README.md.
{
	# Le placeholder est **quoté** : une variable vide produirait sinon zéro
	# argument, et Caddy refuserait de démarrer avec « wrong argument count
	# after 'email' ». Quoté, il vaut la chaîne vide — équivalent à ne pas
	# fournir de contact ACME, ce qui est exactement le cas en local où l'AC
	# interne est utilisée.
	email "{$ACME_EMAIL}"
	servers {
		protocols h1 h2 h3
	}

	# La redirection HTTP→HTTPS est reprise à la main juste en dessous. Motif :
	# celle que Caddy génère seul vit HORS de tout bloc de site, n'exécute donc
	# aucune directive `header`, et émet `Server: Caddy` — la seule réponse du
	# frontal à le faire. Mesuré le 21/08/2026 : `curl -I http://…/` renvoyait
	# `308` avec `Server: Caddy`.
	#
	# Ce réglage ne touche PAS le challenge ACME HTTP-01 : sa route est
	# installée avant les blocs de site et reste prioritaire sur le bloc
	# `http://` ci-dessous. Vérifié le 21/08/2026 (voir 08 §6.5).
	auto_https disable_redirects
}

# Redirection HTTP→HTTPS, explicite et sans signature de serveur.
#
# Bloc attrape-tout : il vaut pour TOUS les domaines de conf.d/, présents et à
# venir. Ne pas le dupliquer par service.
#
# `header` sans matcher plutôt que via (hardened) : les autres en-têtes de
# durcissement n'ont aucun sens sur un 308 qui ne porte pas de contenu.
http:// {
	header -Server
	redir https://{host}{uri} permanent
}

# ─── Fragments réutilisables ──────────────────────────────────────────────
# Importés par les blocs de conf.d/ via `import <nom>`.

# tls_config est **volontairement vide** dans cette variante : Caddy gère les
# certificats tout seul, par ACME ou par son autorité interne. Le fragment
# existe pour que les fichiers de conf.d/ soient rigoureusement identiques
# entre ce montage et la variante Cloudflare (Caddyfile.cloudflare), où il
# porte le certificat d'origine et l'authentification du client.
(tls_config) {
}

# Compression et en-têtes de sécurité communs à tous les services exposés.
(hardened) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Fichiers de refus d'indexation et d'entraînement : /robots.txt, /llms.txt, /ai.txt.
#
# Servis par le frontal et non par l'application : ils décrivent le DOMAINE, pas
# l'API. Le contenu vit dans deploy/static/, monté en lecture seule sur
# /srv/indexation et partagé avec le profil `caddy` dédié.
#
# Deux subtilités d'ordonnancement, toutes deux nécessaires :
#
#  1. `file_server` est ordonné APRÈS `reverse_proxy`. Écrire `root @m …` puis
#     `file_server @m` dans le style du `respond @ops 403` ci-dessous ne
#     marcherait pas : le `reverse_proxy` nu des blocs de conf.d/ capterait
#     /robots.txt en premier et l'API répondrait 404. D'où le `handle`, qui est
#     ordonné avant `reverse_proxy`.
#
#  2. `handle` est ordonné avant `respond`, donc ce fragment passe AVANT le 403
#     de (anti-ia) : un robot par ailleurs refusé lit quand même robots.txt.
#     C'est indispensable — la RFC 9309 §2.3.1.4 interprète un robots.txt en 4xx
#     comme « aucune restriction », et un 403 ici produirait l'effet inverse de
#     celui recherché.
#
# Ne jamais introduire un `handle` SANS matcher dans un bloc de site : il
# capterait tout avant le `respond @ops 403` de (ops-privees) et ferait fuiter
# /metrics vers Internet.
(indexation-refusee) {
	# L'en-tête vit ICI et non dans (hardened) : un `header` contenant `-Server`
	# est marqué `deferred` par Caddy, donc appliqué à l'écriture de la réponse,
	# APRÈS tout `header` posé plus loin dans le bloc de site. Un service à
	# indexer ne pourrait alors plus le neutraliser — ni par `-X-Robots-Tag`, ni
	# par écrasement, ni avec `defer`. Vérifié le 21/08/2026 : les trois échouent.
	#
	# En le plaçant dans ce fragment, la composition redevient explicite :
	# un service à référencer n'importe simplement pas `indexation-refusee`.
	#
	# `noai` et `noimageai` ne sont pas normalisés (convention Spawning) :
	# inoffensifs pour les autres robots, lus par ceux qui les comprennent.
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai"

	@fichiers-indexation path /robots.txt /llms.txt /ai.txt
	handle @fichiers-indexation {
		root * /srv/indexation
		# Explicite plutôt que déduit de l'extension : avec `nosniff`, un
		# Content-Type erroné rendrait le fichier illisible sans recours.
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
}

# Robots d'entraînement notoires : refus EFFECTIF, pas seulement déclaratif.
#
# Complète (indexation-refusee) et X-Robots-Tag, ne les remplace pas : ceux-ci
# s'adressent aux robots qui coopèrent, celui-ci à ceux qui les ignorent.
#
# Limites assumées (ADR 0008) : la liste vieillit, et un agent qui falsifie son
# User-Agent passe au travers. C'est une gêne, pas une barrière.
#
# `Google-Extended` et `Applebot-Extended` sont volontairement ABSENTS : ce sont
# des jetons robots.txt, pas des User-Agent — ils ne matcheraient jamais ici, et
# filtrer `Applebot` bloquerait Siri et Spotlight, ce qui est une autre décision.
#
# `ChatGPT-User`, `Claude-User` et `Perplexity-User` désignent des récupérations
# demandées par un humain, pas du moissonnage. Les refuser est un choix délibéré :
# les retirer du motif si l'on veut laisser passer la consultation à la demande.
(anti-ia) {
	@robots-ia header_regexp User-Agent "(?i)(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|CCBot|Bytespider|Amazonbot|Meta-External|FacebookBot|Diffbot|cohere-ai|cohere-training-data-crawler|MistralAI-User|AI2Bot|Ai2Bot-Dolma|YouBot|DuckAssistBot|ImagesiftBot|Timpibot|PanguBot|Webzio-Extended|SemrushBot-OCOB|FirecrawlAgent|img2dataset|Omgilibot)"
	respond @robots-ia 403
}

# Endpoints d'exploitation : JAMAIS servis par le frontal public.
#
# Le filtrage par `remote_ip private_ranges` a été écarté après vérification : l'adresse
# source vue par Caddy dépend du mode de publication des ports. Sous Docker Desktop,
# OrbStack, un userland-proxy ou un CDN en amont, elle est celle d'une passerelle privée
# — la règle laisse alors passer /metrics vers Internet en croyant le refuser. Vérifié
# le 15/08/2026 : `curl https://…/metrics` depuis l'hôte renvoyait 200 au lieu de 403.
#
# Prometheus n'a de toute façon pas à passer par le frontal : il scrute `api:8080/metrics`
# directement sur le réseau `internal`, qui n'a aucune route entrante depuis Internet.
(ops-privees) {
	@ops path /metrics /debug/*
	respond @ops 403

	# Variante « supervision distante » : si le collecteur est sur une autre machine,
	# remplacer le bloc ci-dessus par un allowlist explicite de son adresse publique.
	# Ne jamais y mettre `private_ranges` : voir ci-dessus.
	#
	#   @ops-refuse {
	#       path /metrics /debug/*
	#       not remote_ip 203.0.113.7
	#   }
	#   respond @ops-refuse 403
}

# ─── Services ─────────────────────────────────────────────────────────────
# Aucun nom d'hôte n'est déclaré ici : un domaine absent de conf.d/ n'est pas
# servi, et aucun certificat n'est demandé pour lui. Fermé par défaut.

import conf.d/*.caddy
