# Configuration du frontal mutualisé — copier en `.env` dans ce répertoire.
#
#   cp .env.example .env

# Adresse de contact ACME. Let's Encrypt y envoie les alertes d'expiration.
# Obligatoire : la stack refuse de démarrer sans.
ACME_EMAIL=ops@example.org

# Domaine servi pour meds-api.
#   - nom public (meds.example.org) → certificat Let's Encrypt automatique ;
#     l'enregistrement DNS doit pointer vers ce serveur AVANT le démarrage.
#   - nom en .localhost → Caddy génère son AC interne et signe lui-même.
MEDS_DOMAIN=meds.localhost

# Ajouter ici une variable par service supplémentaire, si ses blocs de conf.d/
# utilisent des placeholders {$…} plutôt qu'un domaine écrit en dur.
# AUTRE_DOMAIN=autre.example.org
