# Frontal mutualisé — variante **Cloudflare en proxy**.
#
# À monter à la place de Caddyfile lorsque le trafic entre par Cloudflare :
#
#   docker compose -f docker-compose.yml -f compose.cloudflare.yml up -d
#
# Les blocs de conf.d/ sont partagés avec la variante ACME, sans modification :
# ils importent `tls_config`, que chaque variante définit à sa façon.
{
	# Aucun `email` : il n'y a plus d'ACME du tout. Le certificat vient de
	# Cloudflare, vaut quinze ans, et n'est reconnu que par Cloudflare — ce
	# qui est exactement son usage. Corollaire agréable : le port 80 n'a plus
	# besoin d'être joignable depuis Internet, et il n'y a plus de quota Let's
	# Encrypt à ménager ni de renouvellement à surveiller.

	servers {
		# HTTP/1.1 et HTTP/2 uniquement. Cloudflare négocie HTTP/3 avec le
		# navigateur, mais se connecte à l'origine en h1 ou h2 : annoncer h3
		# ici n'apporterait rien et ajouterait un `alt-svc` trompeur, puisque
		# le client ne parle jamais directement à ce serveur.
		protocols h1 h2
	}

	# Cloudflare redirige déjà HTTP vers HTTPS à sa périphérie (« Always Use
	# HTTPS »). Le port 80 de l'origine n'est pas publié ; désactiver les
	# redirections évite que Caddy tente de l'écouter et journalise un
	# avertissement à chaque démarrage.
	#
	# Corollaire : la variante ACME porte, elle, un bloc `http://` explicite pour
	# que sa redirection n'émette pas `Server: Caddy` — la redirection générée par
	# Caddy vit hors de tout bloc de site et n'exécute aucune directive `header`.
	# Ici ce bloc serait inutile : le port 80 n'est pas publié, et Cloudflare
	# redirige à sa périphérie.
	auto_https disable_redirects
}

# ─── Fragments réutilisables ──────────────────────────────────────────────

# tls_config porte la terminaison TLS. C'est le **seul** point qui diffère de
# la variante ACME, où le même fragment est vide : les fichiers de conf.d/
# restent ainsi identiques d'un montage à l'autre.
#
# Deux mécanismes distincts, à ne pas confondre :
#
#  1. Le **certificat d'origine** répond au mode « Full (strict) » de
#     Cloudflare, qui vérifie le certificat présenté par l'origine. Sans lui,
#     seul le mode « Full » fonctionnerait — chiffré mais non vérifié, donc
#     vulnérable à une interposition entre Cloudflare et le serveur.
#
#  2. **Authenticated Origin Pulls** fait l'inverse : c'est Caddy qui exige un
#     certificat client, présenté par Cloudflare et signé par son autorité.
#     C'est ce qui empêche de contourner Cloudflare en visant directement
#     l'adresse IP du serveur — sans quoi l'API serait servie sans WAF, sans
#     protection contre le déni de service et sans les règles de Cloudflare.
#     Le pare-feu restreint aux plages Cloudflare est la seconde barrière ;
#     les deux se cumulent, aucune ne remplace l'autre.
(tls_config) {
	tls /certs/origin.pem /certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /certs/cloudflare-origin-pull-ca.pem
			}
		}
	}
}

# Compression et en-têtes de sécurité communs à tous les services exposés.
#
# HSTS est conservé bien que Cloudflare puisse l'ajouter : l'en-tête est
# produit par l'origine, donc il survit à un changement de configuration côté
# Cloudflare. Une garantie de sécurité qui dépend d'un réglage dans une
# interface tierce n'en est pas tout à fait une.
(hardened) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Fichiers de refus d'indexation et d'entraînement : /robots.txt, /llms.txt, /ai.txt.
#
# Fragment identique à celui de la variante ACME — les fichiers de conf.d/ sont
# partagés, donc les fragments qu'ils importent doivent exister des deux côtés.
#
# Servis par le frontal et non par l'application : ils décrivent le DOMAINE, pas
# l'API. Le contenu vit dans deploy/static/, monté en lecture seule sur
# /srv/indexation.
#
# Deux subtilités d'ordonnancement, toutes deux nécessaires :
#
#  1. `file_server` est ordonné APRÈS `reverse_proxy` : sans `handle`, le
#     `reverse_proxy` nu des blocs de conf.d/ capterait /robots.txt en premier
#     et l'API répondrait 404. `handle`, lui, précède `reverse_proxy`.
#
#  2. `handle` est ordonné avant `respond`, donc ce fragment passe AVANT le 403
#     de (anti-ia) : un robot par ailleurs refusé lit quand même robots.txt.
#     Indispensable — la RFC 9309 §2.3.1.4 interprète un robots.txt en 4xx comme
#     « aucune restriction ».
#
# Ne jamais introduire un `handle` SANS matcher dans un bloc de site : il
# capterait tout avant le `respond @ops 403` de (ops-privees).
#
# Note Cloudflare : le cache de Cloudflare peut servir ces fichiers depuis sa
# périphérie. C'est sans conséquence — leur contenu est statique et public — mais
# une modification met jusqu'à la durée de cache à se propager. Purger l'URL si
# le changement doit être immédiat.
(indexation-refusee) {
	# L'en-tête vit ICI et non dans (hardened) : un `header` contenant `-Server`
	# est marqué `deferred` par Caddy, donc appliqué à l'écriture de la réponse,
	# APRÈS tout `header` posé plus loin dans le bloc de site. Un service à
	# indexer ne pourrait alors plus le neutraliser — ni par `-X-Robots-Tag`, ni
	# par écrasement, ni avec `defer`. Vérifié le 21/08/2026 : les trois échouent.
	#
	# En le plaçant dans ce fragment, la composition redevient explicite :
	# un service à référencer n'importe simplement pas `indexation-refusee`.
	#
	# `noai` et `noimageai` ne sont pas normalisés (convention Spawning) :
	# inoffensifs pour les autres robots, lus par ceux qui les comprennent.
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai"

	@fichiers-indexation path /robots.txt /llms.txt /ai.txt
	handle @fichiers-indexation {
		root * /srv/indexation
		# Explicite plutôt que déduit de l'extension : avec `nosniff`, un
		# Content-Type erroné rendrait le fichier illisible sans recours.
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
}

# Robots d'entraînement notoires : refus EFFECTIF, pas seulement déclaratif.
#
# Complète (indexation-refusee) et X-Robots-Tag, ne les remplace pas.
#
# Derrière Cloudflare, ce filtrage fait doublon avec la règle « AI Scrapers and
# Crawlers » du tableau de bord, qui est plus à jour et agit avant d'atteindre
# l'origine. Il est conservé ici pour la même raison que HSTS : une garantie qui
# dépend d'un réglage dans une interface tierce n'en est pas tout à fait une.
#
# Limites assumées (ADR 0008) : la liste vieillit, et un agent qui falsifie son
# User-Agent passe au travers.
#
# `Google-Extended` et `Applebot-Extended` sont volontairement ABSENTS : jetons
# robots.txt, pas User-Agent. `ChatGPT-User`, `Claude-User` et `Perplexity-User`
# désignent des récupérations demandées par un humain — les refuser est un choix
# délibéré, à retirer du motif pour laisser passer la consultation à la demande.
(anti-ia) {
	@robots-ia header_regexp User-Agent "(?i)(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|CCBot|Bytespider|Amazonbot|Meta-External|FacebookBot|Diffbot|cohere-ai|cohere-training-data-crawler|MistralAI-User|AI2Bot|Ai2Bot-Dolma|YouBot|DuckAssistBot|ImagesiftBot|Timpibot|PanguBot|Webzio-Extended|SemrushBot-OCOB|FirecrawlAgent|img2dataset|Omgilibot)"
	respond @robots-ia 403
}

# Endpoints d'exploitation : JAMAIS servis par le frontal public.
#
# Le raisonnement vaut a fortiori derrière Cloudflare : l'adresse source vue
# par Caddy est celle d'un datacenter Cloudflare, jamais celle du client. Un
# filtrage par `remote_ip private_ranges` n'aurait ici strictement aucun sens
# (ADR 0006). Prometheus scrute `api:8080/metrics` en direct sur le réseau
# interne.
(ops-privees) {
	@ops path /metrics /debug/*
	respond @ops 403
}

# ─── Services ─────────────────────────────────────────────────────────────
# Fichiers partagés avec la variante ACME, sans modification.

import conf.d/*.caddy
