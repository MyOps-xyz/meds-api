{
  "$schema": "https://json.schemastore.org/semantic-release.json",
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Fonctionnalités"
            },
            {
              "type": "fix",
              "section": "Corrections"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "revert",
              "section": "Retours arrière"
            },
            {
              "type": "refactor",
              "section": "Refactorisations",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "Documentation",
              "hidden": false
            },
            {
              "type": "build",
              "section": "Build et dépendances",
              "hidden": false
            },
            {
              "type": "test",
              "hidden": true
            },
            {
              "type": "ci",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "chore",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./.github/scripts/prepare-release.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/meds-api_*_linux_amd64.tar.gz",
            "label": "meds-api ${nextRelease.gitTag} — linux/amd64"
          },
          {
            "path": "dist/meds-api_*_linux_arm64.tar.gz",
            "label": "meds-api ${nextRelease.gitTag} — linux/arm64"
          },
          {
            "path": "dist/meds-api_*_checksums.txt",
            "label": "Sommes de contrôle SHA-256"
          }
        ]
      }
    ]
  ]
}
